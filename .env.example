# Environment Configuration for Secure Payment & Wallet System

# Node Environment
NODE_ENV=production
PORT=5000
JWT_SECRET=super_secure_random_jwt_secret_change_in_production_min32chars
SESSION_SECRET=super_secure_session_secret_change_in_production

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://db_user:db_password@localhost:5432/secure_wallet_db?sslmode=prefer

# Meta / WhatsApp Business Cloud API Configuration
# Get from developers.facebook.com -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=109283746501928
WHATSAPP_ACCESS_TOKEN=EAABwz...your_system_user_permanent_token...
WHATSAPP_WEBHOOK_VERIFY_TOKEN=random_webhook_verification_token

# JazzCash Merchant Gateway Credentials
# Request from JazzCash Merchant Portal
JAZZ_CASH_MERCHANT_ID=MC12345
JAZZ_CASH_PASSWORD=password123
JAZZ_CASH_INTEGERITY_SALT=salt_key_12345
JAZZ_CASH_RETURN_URL=https://yourdomain.com/api/webhooks/jazzcash

# EasyPaisa Merchant Gateway Credentials
# Request from EasyPaisa Merchant Operations
EASYPAISA_STORE_ID=98765
EASYPAISA_HASH_KEY=easypaisa_sha256_secret_key
EASYPAISA_POST_URL=https://easypay.easypaisa.com.pk/easypay/Index.jsf

# FastPay / FlashPay Credentials
FASTPAY_MERCHANT_ID=FP_889900
FASTPAY_SECRET_KEY=fastpay_secure_key

# Admin Defaults (Seeded during initial migration)
SUPER_ADMIN_EMAIL=admin@system.com
SUPER_ADMIN_INITIAL_PASSWORD=Admin@SecurePass2026!
